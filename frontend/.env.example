# Backend origin (do not include /api). Restart Vite after changing these values.
VITE_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Defaults are /api/auth/login and /api/auth/signup.
# The current backend exposes the following aliases instead:
VITE_AUTH_LOGIN_PATH=/api/auth/sign-in
VITE_AUTH_SIGNUP_PATH=/api/auth/sign-up

# Google OAuth Web client ID; must match GOOGLE_CLIENT_ID on the backend.
# Add the frontend origin to the client's Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# IANA timezone of the restaurant. Booking slots and the prefill date cutoff are judged in this
# timezone, to match RESTAURANT_TIMEZONE on the backend. Defaults to Africa/Lagos.
VITE_RESTAURANT_TIMEZONE=Africa/Lagos