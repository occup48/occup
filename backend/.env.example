# Copy this file to .env.local in the backend directory and replace the placeholders.
PORT=5000
FRONTEND_URL=

# Paste the complete PostgreSQL connection string from your Neon project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Replace this placeholder with a unique secret generated using:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-generated-random-secret"

# Optional: access-token lifetime (defaults to 1h).
JWT_EXPIRES_IN=1h

## Google
GOOGLE_CLIENT_ID=

## Timezone (the restaurant's IANA timezone, used for "today" in availability and reservation checks. Defaults to Africa/Lagos if unset)
RESTAURANT_TIMEZONE=Africa/Lagos